{
	"name": "blank-plugin",
	"version": "1.0.0",
	"description": "Example block scaffolded with Create Block tool.",
	"author": "Rabindra Tharu",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"plugin"
	],
	"homepage": "https://www.linkedin.com/in/rabindratharu/",
	"repository": {
		"type": "git",
		"url": "https://github.com/rabindratharu/blank-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/rabindratharu/blank-plugin/issues"
	},
	"main": "Gruntfile.js",
	"private": true,
	"dependencies": {
		"@tailwindcss/postcss": "^4.1.16",
		"@wordpress/base-styles": "^6.10.0",
		"@wordpress/block-editor": "^15.7.0",
		"@wordpress/blocks": "^15.7.0",
		"@wordpress/components": "^30.7.0",
		"@wordpress/compose": "^7.34.0",
		"@wordpress/data": "^10.34.0",
		"@wordpress/element": "^6.34.0",
		"@wordpress/eslint-plugin": "^22.20.0",
		"@wordpress/hooks": "^4.34.0",
		"@wordpress/i18n": "^6.7.0",
		"@wordpress/icons": "^11.1.0",
		"@wordpress/scripts": "^30.27.0",
		"@wordpress/server-side-render": "^6.10.0",
		"atrc": "^1.0.37",
		"classnames": "^2.5.1",
		"css-minimizer-webpack-plugin": "^7.0.2",
		"dotenv": "^17.2.3",
		"lodash": "^4.17.21",
		"react-icons": "^5.5.0",
		"tailwindcss": "^4.1.16"
	},
	"devDependencies": {
		"@svgr/cli": "^8.1.0",
		"@wordpress/stylelint-config": "^23.26.0",
		"autoprefixer": "^10.4.21",
		"copy-webpack-plugin": "^13.0.1",
		"cross-env": "^7.0.3",
		"css-loader": "^7.1.2",
		"cypress": "^13.6.0",
		"grunt": "^1.5.3",
		"grunt-checktextdomain": "^1.0.1",
		"grunt-contrib-clean": "^2.0.1",
		"grunt-contrib-compress": "^2.0.0",
		"grunt-contrib-copy": "^1.0.0",
		"grunt-wp-i18n": "^1.0.4",
		"load-grunt-tasks": "^5.1.0",
		"mini-css-extract-plugin": "^2.9.4",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.0",
		"postcss-scss": "^4.0.9",
		"rtlcss-webpack-plugin": "^4.0.7",
		"sass": "^1.93.2",
		"sass-loader": "^16.0.5",
		"shx": "^0.4.0",
		"terser-webpack-plugin": "^5.3.14",
		"webpack": "^5.89.0",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"scripts": {
		"composer-start": "shx rm -rf vendor/ composer.lock && composer clear-cache && composer install",
		"composer-build": "shx rm -rf vendor/ composer.lock && composer clear-cache && composer install --no-dev --prefer-dist --optimize-autoloader",
		"build": "npm run clean && wp-scripts build --mode=production",
		"start": "npm run clean && wp-scripts start --mode=development",
		"clean": "shx rm -rf assets/build/*",
		"lint:js": "wp-scripts lint-js 'assets/src/**/*.js'",
		"lint:js:fix": "wp-scripts lint-js 'assets/src/**/*.js' --fix",
		"lint:css": "wp-scripts lint-style 'assets/src/**/*.{css,scss}'",
		"lint:css:fix": "wp-scripts lint-style 'assets/src/**/*.{css,scss}' --fix",
		"lint:pkg": "wp-scripts lint-pkg-json",
		"format:js": "wp-scripts format assets/src/js",
		"lint:php": "vendor/bin/phpcs",
		"lint:php:fix": "vendor/bin/phpcbf",
		"lint:package-json": "wp-scripts lint-pkg-json --ignorePath .gitignore",
		"packages-update": "wp-scripts packages-update",
		"cypress:open": "node_modules/.bin/cypress open",
		"translate": "wp i18n make-pot . languages/blank-plugin.pot --include=\"assets/src/**/*.js,*.php,inc/**/*.php\" --exclude=\"assets/src/library/**,builds/,node_modules/,cypress/,vendor/,tests/,build/\" --ignore-domain --allow-root",
		"release": "npm run build && npm run translate && grunt build"
	},
	"browserslist": {
		"production": [
			"> 0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
